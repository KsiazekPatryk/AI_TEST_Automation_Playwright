{
  "name": "ai_test_automation_playwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "test": "playwright test",
    "test:list": "playwright test --list",
    "test:ui": "playwright test tests/ui --project=ui",
    "test:api": "playwright test tests/api --project=api",
    "test:e2e": "playwright test tests/e2e --project=e2e",
    "test:all": "playwright test --project=api --project=ui --project=e2e",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:schema": "playwright test --grep @schema",
    "test:destructive": "playwright test --grep @destructive --workers=1",
    "test:affected": "tsx src/test-selection/run.ts",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" package.json tsconfig.json playwright.config.ts eslint.config.mjs \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" package.json tsconfig.json playwright.config.ts eslint.config.mjs \".github/workflows/*.yml\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KsiazekPatryk/AI_TEST_Automation_Playwright.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/KsiazekPatryk/AI_TEST_Automation_Playwright/issues"
  },
  "homepage": "https://github.com/KsiazekPatryk/AI_TEST_Automation_Playwright#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "prettier": {
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "endOfLine": "auto",
    "printWidth": 120
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "chalk": "^4.1.2",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  }
}
